#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        partial_screenshot: partial_screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp LEFT_SHIFT &kp S>,
                <&macro_release>;

            label = "PARTIAL_SCREENSHOT";
        };

        SKIP_WORD_RIGHT: SKIP_WORD_RIGHT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT &kp RIGHT_ARROW>,
                <&macro_release>;

            label = "SKIP_WORD_RIGHT";
        };

        SKIP_WORD_LEFT: SKIP_WORD_LEFT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT &kp LEFT_ARROW>,
                <&macro_release>;

            label = "SKIP_WORD_LEFT";
        };

        CODE_COMMENT: CODE_COMMENT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN &kp SLASH>,
                <&macro_release>;

            label = "CODE_COMMENT";
        };

        COLLAPSE_LEVEL: COLLAPSE_LEVEL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN>,
                <&macro_tap>,
                <&kp K>,
                <&macro_release>,
                <&kp LEFT_COMMAND>;

            label = "COLLAPSE_LEVEL";
        };

        SCREENSHOT_SAVE: SCREENSHOT_SAVE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_COMMAND &kp LEFT_SHIFT &kp NUMBER_4>,
                <&macro_release>;

            label = "SCREENSHOT_SAVE";
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            display-name = "Base";
            bindings = <
&kp ESC                 &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3      &kp NUMBER_4         &kp N5                                                                 &kp NUMBER_6                 &kp N7                &kp N8             &kp N9   &kp N0    &kp EQUAL
&kp TAB                 &kp Q         &kp W         &kp E             &kp R                &kp T                                                                  &kp Y                        &kp U                 &kp I              &kp O    &kp P     &kp MINUS
&mt LEFT_COMMAND ENTER  &kp A         &kp S         &kp D             &kp F                &kp G                                                                  &kp H                        &kp J                 &kp K              &kp L    &kp SEMI  &mt LEFT_COMMAND ENTER
&kp LSHFT               &kp Z         &kp X         &kp C             &kp V                &kp B                       &lt 1 LEFT_BRACKET    &lt 1 RIGHT_BRACKET  &kp N                        &kp M                 &kp COMMA          &kp DOT  &kp FSLH  &kp RSHFT
                                                    &kp LEFT_CONTROL  &mt LEFT_ALT DELETE  &mt LEFT_COMMAND BACKSPACE  &lt 2 SPACE           &lt 2 ENTER          &mt RIGHT_COMMAND BACKSPACE  &mt RIGHT_ALT DELETE  &kp RIGHT_CONTROL
            >;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Lower";
            bindings = <
&trans  &trans  &trans           &trans          &SCREENSHOT_SAVE  &kp HOME                         &trans     &kp K_PREV       &kp C_PLAY      &kp K_FORWARD     &kp C_MUTE     &kp C_VOLUME_UP
&trans  &trans  &SKIP_WORD_LEFT  &kp UP_ARROW    &SKIP_WORD_RIGHT  &kp PAGE_UP                      &trans     &SKIP_WORD_LEFT  &kp UP_ARROW    &SKIP_WORD_RIGHT  &trans         &kp C_VOLUME_DOWN
&trans  &trans  &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW   &kp PAGE_DOWN                    &kp SQT    &kp LEFT_ARROW   &kp DOWN_ARROW  &kp RIGHT_ARROW   &trans         &trans
&trans  &trans  &trans           &trans          &trans            &trans         &trans    &trans  &kp TILDE  &kp PIPE         &kp SEMICOLON   &kp COLON         &kp BACKSLASH  &trans
                                 &trans          &trans            &trans         &trans    &trans  &trans     &trans           &trans
            >;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            display-name = "Raise";
            bindings = <
&trans      &kp F1      &kp F2  &kp F3  &kp F4  &kp F5                        &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&bt BT_PRV  &bt BT_NXT  &trans  &trans  &trans  &bt BT_CLR                    &trans  &trans  &trans  &trans  &trans   &kp F12
&trans      &trans      &trans  &trans  &trans  &trans                        &trans  &trans  &trans  &trans  &trans   &trans
&trans      &trans      &trans  &trans  &trans  &trans      &trans    &trans  &trans  &trans  &trans  &trans  &trans   &trans
                                &trans  &trans  &trans      &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
